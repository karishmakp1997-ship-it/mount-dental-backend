DEBUG=True
SECRET_KEY=paste-generated-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_URL=manage-clinic/
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Production only (leave commented locally, SQLite is used by default)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email — alerts the clinic and confirms bookings to patients when someone
# submits the appointment form. Leave this whole section commented out and
# emails just print in the terminal instead of sending (booking still works).
#
# To send real emails for free with a Gmail account:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords
#      (choose "Mail" as the app — it gives you a 16-character password)
#   3. Uncomment the 6 lines below and fill them in
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=your-clinic-gmail@gmail.com
# EMAIL_HOST_PASSWORD=paste-the-16-character-app-password-here
# DEFAULT_FROM_EMAIL=your-clinic-gmail@gmail.com
# CLINIC_NOTIFY_EMAIL=your-clinic-gmail@gmail.com
# Free Gmail sending has a ~500 emails/day limit — plenty for a clinic's booking volume.